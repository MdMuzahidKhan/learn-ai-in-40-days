{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug FastAPI Day07",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "app:app",
        "--host",
        "127.0.0.1",
